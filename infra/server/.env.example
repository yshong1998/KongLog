# 서버용 구성(compose.yaml)이 읽는 값. 이 파일을 같은 폴더에 .env로 복사한 뒤 값을 넣는다.
#   cp infra/server/.env.example infra/server/.env
# .env는 저장소에 올리지 않는다. 이 파일에는 이름만 두고 비밀 값을 적지 않는다.

# 블로그 주소. 내 컴퓨터에서는 localhost, 서버에서는 konglog.my.
SITE_DOMAIN=localhost

# 띄울 이미지. 내 컴퓨터에서는 infra/README.md의 "Docker 이미지"대로 만든 이름을 넣는다.
FRONTEND_IMAGE=konglog-frontend:local
BACKEND_IMAGE=konglog-backend:local

# DB 이름과 계정. 처음 띄울 때 이 값으로 DB가 만들어진다.
# 로컬 개발용 계정과 비밀번호(konglog)를 서버에서 쓰지 않는다.
# 비밀번호는 길고 무작위인 값을 직접 만들어 넣는다. 예: openssl rand -hex 24
POSTGRES_DB=konglog
POSTGRES_USER=
POSTGRES_PASSWORD=
