# Caddy 설정. 밖에서 들어오는 요청을 받아 나눠 준다. compose.yaml이 컨테이너 안으로 넣어 준다.
# 주소가 /api로 시작하면 Spring Boot로, 나머지는 Next.js로 보낸다.
# 도메인은 환경 변수 SITE_DOMAIN으로 받는다. HTTPS 인증서는 Caddy가 알아서 받고 갱신한다.
#   SITE_DOMAIN=localhost  → 내 컴퓨터용. Caddy가 직접 만든 인증서를 쓴다(브라우저가 경고한다).
#   SITE_DOMAIN=konglog.my → 서버용. 공인 인증서를 발급받는다.
# http://로 들어온 요청은 Caddy가 https://로 넘긴다.
# 공개 전까지 모든 응답에 검색엔진 수집 금지 표시를 붙인다. 환경 변수 BLOCK_SEARCH_ENGINES로 끈다.

{$SITE_DOMAIN} {
	encode zstd gzip

	# 검색엔진에게 "이 주소를 검색 결과에 넣지 말라"고 알리는 응답 헤더를 붙인다.
	# 화면과 /api에 모두 붙는다. 헤더라서 HTML이 아닌 응답(JSON)에도 쓸 수 있다.
	# 값이 정확히 false일 때만 붙이지 않는다. 비었거나 잘못 적혀 있으면 막는 쪽으로 둔다.
	@block-search expression `"{$BLOCK_SEARCH_ENGINES:true}" != "false"`
	header @block-search X-Robots-Tag "noindex, nofollow"

	# /apix 같은 주소가 걸리지 않게 /api와 /api/로 시작하는 주소만 고른다.
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
